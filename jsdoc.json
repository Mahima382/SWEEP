{
  "source": {
    "include": ["frontend/src", "backend"],
    "exclude": [
      "node_modules",
      "backend/node_modules",
      "frontend/node_modules",
      "frontend/dist",
      "docs"
    ],
    "includePattern": ".+\\.js(x)?$"
  },
  "opts": { "destination": "./docs", "recurse": true }
}
